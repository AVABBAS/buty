# ==============================================================================
# AYNA EDITORIAL BEAUTY & STYLE - RAILWAY & NEON CONFIGURATION GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE (Database Storage)
# ------------------------------------------------------------------------------
# Copy the connection string directly from your Neon Console (neon.tech)
# Make sure to include "?sslmode=require" at the end.
# Supports both Pooled (ep-xyz-pooler) and Direct connections.
# The server automatically detects Neon and handles:
#   - Serverless compute wake-up (auto-retry & 10s connection timeout)
#   - Strict SSL with rejectUnauthorized: false
#   - Automatic schema creation & indexes (ayna_users, ayna_user_data, ayna_subscriptions)
#
# If left empty, the app automatically falls back to an embedded JSON database in /data.
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Maximum connections in the pool (default: 20)
# PG_MAX_POOL=20

# ------------------------------------------------------------------------------
# 2. RAILWAY APPLICATION HOSTING (Server Runtime)
# ------------------------------------------------------------------------------
# Railway automatically assigns the PORT environment variable.
# The server automatically listens on 0.0.0.0:$PORT
PORT=3000

# Node Environment: set to 'production' on Railway
NODE_ENV=production

# APP_URL: Your Railway public domain (e.g. https://your-project.up.railway.app)
# Used for Telegram WebApp Menu Button and webhook integration.
APP_URL="https://your-project.up.railway.app"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Intelligence Engine)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT INTEGRATION (Optional but Recommended)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram.
# The app automatically sets up the Telegram WebApp Menu Button.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Optional: Webhook secret token for securing /api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET="YOUR_RANDOM_SECRET_KEY"
